#include "resource.h"
#include "afxres.h"
#include "verrsrc.h"
#pragma code_page(65001)
LANGUAGE LANG_KOREAN, SUBLANG_DEFAULT
IDR_MAINFRAME ICON "res\\CodexUsage.ico"
IDD_CODEXUSAGE_DIALOG DIALOGEX 0, 0, 206, 172
STYLE DS_SETFONT | WS_POPUP | WS_SYSMENU | WS_MINIMIZEBOX | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW
FONT 9, "Segoe UI"
BEGIN
END
IDD_SETTINGS DIALOGEX 0, 0, 230, 230
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Codex Usage Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Opacity (%) [20-100]", -1, 8, 11, 132, 12
    EDITTEXT IDC_OPACITY, 146, 8, 76, 16, ES_NUMBER | WS_TABSTOP
    CONTROL "", IDC_OPACITY_SPIN, "msctls_updown32", UDS_ALIGNRIGHT | UDS_SETBUDDYINT | UDS_ARROWKEYS, 212, 8, 10, 16
    LTEXT "Refresh interval (seconds)", -1, 8, 33, 132, 12
    EDITTEXT IDC_INTERVAL, 146, 30, 76, 16, ES_NUMBER | WS_TABSTOP
    CONTROL "", IDC_INTERVAL_SPIN, "msctls_updown32", UDS_ALIGNRIGHT | UDS_SETBUDDYINT | UDS_ARROWKEYS, 212, 30, 10, 16
    CONTROL "Always on top", IDC_TOPMOST, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 51, 214, 14
    CONTROL "Run at login", IDC_AUTOSTART, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 69, 104, 14
    CONTROL "Start in tray", IDC_START_TRAY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 118, 69, 104, 14
    CONTROL "Save usage data to CSV", IDC_SAVE_CSV, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 87, 214, 14
    LTEXT "Warning (%)", -1, 8, 111, 60, 11
    EDITTEXT IDC_WARNING, 70, 107, 38, 16, ES_NUMBER | WS_TABSTOP
    LTEXT "Alert (%)", -1, 122, 111, 52, 11
    EDITTEXT IDC_ALERT, 184, 107, 38, 16, ES_NUMBER | WS_TABSTOP
    LTEXT "CLI path (blank = auto)", -1, 8, 134, 214, 11
    EDITTEXT IDC_CLI_PATH, 8, 147, 189, 16, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "...", IDC_BROWSE_CLI, "Button", BS_OWNERDRAW | WS_TABSTOP, 201, 147, 21, 16
    LTEXT "GUI path (blank = auto)", -1, 8, 168, 214, 11
    EDITTEXT IDC_GUI_PATH, 8, 181, 189, 16, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "...", IDC_BROWSE_GUI, "Button", BS_OWNERDRAW | WS_TABSTOP, 201, 181, 21, 16
    CONTROL "Save", IDOK, "Button", BS_OWNERDRAW | WS_TABSTOP, 108, 205, 54, 18
    CONTROL "Cancel", IDCANCEL, "Button", BS_OWNERDRAW | WS_TABSTOP, 168, 205, 54, 18
END
IDD_HISTORY DIALOGEX 0, 0, 440, 270
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "Codex Usage History"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Range", -1, 10, 11, 27, 12
    COMBOBOX IDC_HISTORY_RANGE, 39, 8, 96, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "|<", IDC_HISTORY_FIRST, "Button", BS_OWNERDRAW | WS_TABSTOP, 155, 8, 31, 18
    CONTROL "<", IDC_HISTORY_PREV, "Button", BS_OWNERDRAW | WS_TABSTOP, 189, 8, 31, 18
    CONTROL ">", IDC_HISTORY_NEXT, "Button", BS_OWNERDRAW | WS_TABSTOP, 223, 8, 31, 18
    CONTROL ">|", IDC_HISTORY_LAST, "Button", BS_OWNERDRAW | WS_TABSTOP, 257, 8, 31, 18
    CONTROL "Token stats", IDC_TOKEN_STATS, "Button", BS_OWNERDRAW | WS_TABSTOP, 298, 8, 72, 18
    CONTROL "Close", IDOK, "Button", BS_OWNERDRAW | WS_TABSTOP, 385, 8, 45, 18
END
IDD_TOKEN_STATS DIALOGEX 0, 0, 500, 330
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "Codex Token Statistics"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT IDC_TOKEN_STATS_TEXT, 8, 8, 484, 294, ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_READONLY | WS_VSCROLL | WS_HSCROLL
    DEFPUSHBUTTON "Close", IDOK, 442, 306, 50, 18
END
IDD_ABOUT DIALOGEX 0, 0, 220, 112
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Codex Usage"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_ABOUT_ICON, "Static", SS_ICON, 12, 13, 34, 34
    LTEXT "Codex Usage", -1, 56, 13, 150, 14
    LTEXT "Version", IDC_ABOUT_VERSION, 56, 32, 150, 14
    LTEXT "Citopia", -1, 56, 49, 150, 12
    LTEXT "Codex usage monitor for Windows", -1, 12, 73, 190, 12
    CONTROL "Close", IDOK, "Button", BS_OWNERDRAW | WS_TABSTOP, 158, 88, 50, 18
END
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,2026,928
 PRODUCTVERSION 1,0,2026,928
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "041204B0"
  BEGIN
   VALUE "CompanyName", "Citopia"
   VALUE "FileDescription", "Codex Usage Widget"
   VALUE "FileVersion", "1.0.2026.0928"
   VALUE "InternalName", "CodexUsage.exe"
   VALUE "LegalCopyright", "Copyright (C) 2026 Citopia"
   VALUE "OriginalFilename", "CodexUsage.exe"
   VALUE "ProductName", "CodexUsage"
   VALUE "ProductVersion", "1.0.2026.0928"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x412, 1200
 END
END
